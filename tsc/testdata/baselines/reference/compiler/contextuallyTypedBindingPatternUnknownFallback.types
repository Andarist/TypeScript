>{ a: [1] } : { a: [number]; }
>a : [number]
>[1] : [number]
>1 : 1

// Without an initializer, the binding pattern is used
export const noInitializer = unknownRest(({ a, b }) => {});
>noInitializer : [{ a: any; b: any; }]
>unknownRest(({ a, b }) => {}) : [{ a: any; b: any; }]
>unknownRest : <T extends unknown[]>(cb: (...args: T) => void) => T
>({ a, b }) => {} : ({ a, b }: { a: any; b: any; }) => void
>a : any
>b : any

// An any contextual type is used as is
declare function anyRest<T extends any[]>(cb: (...args: T) => void): T;
>anyRest : <T extends any[]>(cb: (...args: T) => void) => T
>cb : (...args: T) => void
>args : T

export const anyContext = anyRest(({ a, b } = { a: 1 }) => {});
>anyContext : [any?]
>anyRest(({ a, b } = { a: 1 }) => {}) : [any?]
>anyRest : <T extends any[]>(cb: (...args: T) => void) => T
>({ a, b } = { a: 1 }) => {} : ({ a, b }?: any) => void
>a : any
>b : any
>{ a: 1 } : { a: number; }
>a : number
>1 : 1

