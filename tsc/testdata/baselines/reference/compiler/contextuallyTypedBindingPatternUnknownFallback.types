export const nestedPattern = unknownRest(({ a: [first, second] } = { a: [1] }) => {});
>nestedPattern : [({ a: [number]; } | undefined)?]
>unknownRest(({ a: [first, second] } = { a: [1] }) => {}) : [({ a: [number]; } | undefined)?]
