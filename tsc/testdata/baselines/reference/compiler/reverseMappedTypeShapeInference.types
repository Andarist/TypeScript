>{                done: ev => ev.type,            } : { done: (ev: { type: string; }) => string; }

                done: ev => ev.type,
>done : (ev: { type: string; }) => string
>ev => ev.type : (ev: { type: string; }) => string
>ev : { type: string; }
>ev.type : string
>ev : { type: string; }
>type : string

