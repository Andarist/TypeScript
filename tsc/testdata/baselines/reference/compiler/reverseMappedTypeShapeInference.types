//// [tests/cases/compiler/reverseMappedTypeShapeInference.ts] ////

=== reverseMappedTypeShapeInference.ts ===
// A source object whose properties are all context sensitive is still reverse mappable: its shape
// is inferable even though none of its property types are. The shape-only inference has lower
// priority than a partial inference made from a source with some inferable property types.

type Identity<T> =
>Identity : Identity<T>

    T extends any
        ? T extends (...a: never) => unknown ? T :
>a : never

          T extends object ? IdentityObject<T> :
          T
        : never;

type IdentityObject<T> = { [K in keyof T]: Identity<T[K]> };
>IdentityObject : IdentityObject<T>

declare const createMachine: <D extends {
>createMachine : <D extends { initial: keyof D["states"]; context: object; states: { [S in keyof D["states"]]: { entry?: (context: D["context"], state: S) => void; _?: null; }; }; }>(definition: IdentityObject<D>) => D

    initial: keyof D["states"],
>initial : keyof D["states"]

    context: object,
>context : object

    states: {
>states : { [S in keyof D["states"]]: { entry?: (context: D["context"], state: S) => void; _?: null; }; }

        [S in keyof D["states"]]: {
            entry?: (context: D["context"], state: S) => void,
>entry : ((context: D["context"], state: S) => void) | undefined
>context : D["context"]
>state : S

            _?: null
>_ : null | undefined
        }
    }
}>(definition: IdentityObject<D>) => D;
>definition : IdentityObject<D>

// All properties of 'a' are context sensitive
const m1 = createMachine({
>m1 : { initial: "a"; context: object; states: { a: { entry?: ((context: { foo: number; }, state: "a") => void) | undefined; _?: null; }; }; }
>createMachine({    initial: "a",    context: { foo: 1 },    states: {        a: {            entry: context => { context.foo; }        }    }}) : { initial: "a"; context: object; states: { a: { entry?: ((context: { foo: number; }, state: "a") => void) | undefined; _?: null; }; }; }
>createMachine : <D extends { initial: keyof D["states"]; context: object; states: { [S in keyof D["states"]]: { entry?: (context: D["context"], state: S) => void; _?: null; }; }; }>(definition: IdentityObject<D>) => D
>{    initial: "a",    context: { foo: 1 },    states: {        a: {            entry: context => { context.foo; }        }    }} : { initial: "a"; context: { foo: number; }; states: { a: { entry: (context: { foo: number; }) => void; }; }; }

    initial: "a",
>initial : "a"
>"a" : "a"

    context: { foo: 1 },
>context : { foo: number; }
>{ foo: 1 } : { foo: number; }
>foo : number
>1 : 1

    states: {
>states : { a: { entry: (context: { foo: number; }) => void; }; }
>{        a: {            entry: context => { context.foo; }        }    } : { a: { entry: (context: { foo: number; }) => void; }; }

        a: {
>a : { entry: (context: { foo: number; }) => void; }
>{            entry: context => { context.foo; }        } : { entry: (context: { foo: number; }) => void; }

            entry: context => { context.foo; }
>entry : (context: { foo: number; }) => void
>context => { context.foo; } : (context: { foo: number; }) => void
>context : { foo: number; }
>context.foo : number
>context : { foo: number; }
>foo : number
        }
    }
});

// Same, with a non-context sensitive property alongside
const m2 = createMachine({
>m2 : { initial: "a"; context: object; states: { a: { entry?: ((context: { foo: number; }, state: "a") => void) | undefined; _?: null; }; }; }
>createMachine({    initial: "a",    context: { foo: 1 },    states: {        a: {            entry: context => { context.foo; },            _: null        }    }}) : { initial: "a"; context: object; states: { a: { entry?: ((context: { foo: number; }, state: "a") => void) | undefined; _?: null; }; }; }
>createMachine : <D extends { initial: keyof D["states"]; context: object; states: { [S in keyof D["states"]]: { entry?: (context: D["context"], state: S) => void; _?: null; }; }; }>(definition: IdentityObject<D>) => D
>{    initial: "a",    context: { foo: 1 },    states: {        a: {            entry: context => { context.foo; },            _: null        }    }} : { initial: "a"; context: { foo: number; }; states: { a: { entry: (context: { foo: number; }) => void; _: null; }; }; }

    initial: "a",
>initial : "a"
>"a" : "a"

    context: { foo: 1 },
>context : { foo: number; }
>{ foo: 1 } : { foo: number; }
>foo : number
>1 : 1

    states: {
>states : { a: { entry: (context: { foo: number; }) => void; _: null; }; }
>{        a: {            entry: context => { context.foo; },            _: null        }    } : { a: { entry: (context: { foo: number; }) => void; _: null; }; }

        a: {
>a : { entry: (context: { foo: number; }) => void; _: null; }
>{            entry: context => { context.foo; },            _: null        } : { entry: (context: { foo: number; }) => void; _: null; }

            entry: context => { context.foo; },
>entry : (context: { foo: number; }) => void
>context => { context.foo; } : (context: { foo: number; }) => void
>context : { foo: number; }
>context.foo : number
>context : { foo: number; }
>foo : number

            _: null
>_ : null
        }
    }
});

type AnyFunction = (...args: any[]) => any;
>AnyFunction : AnyFunction
>args : any[]

type InferNarrowest<T> = T extends any
>InferNarrowest : InferNarrowest<T>

    ? T extends AnyFunction ? T : T extends object ? InferNarrowestObject<T> : T
    : never;

type InferNarrowestObject<T> = { readonly [K in keyof T]: InferNarrowest<T[K]> };
>InferNarrowestObject : InferNarrowestObject<T>

type Config<TGlobal, TState = Prop<TGlobal, "states">> = {
>Config : Config<TGlobal, TState>

    states: { [StateKey in keyof TState]: { on?: Record<string, (ev: { type: string }) => string> } };
>states : { [StateKey in keyof TState]: { on?: Record<string, (ev: { type: string; }) => string>; }; }
>on : Record<string, (ev: { type: string; }) => string> | undefined
>ev : { type: string; }
>type : string

} & { initial: keyof TState };
>initial : keyof TState

type Prop<T, K> = K extends keyof T ? T[K] : never;
>Prop : Prop<T, K>

declare const createMachine2: <TConfig extends Config<TConfig>>(_config: InferNarrowestObject<TConfig>) => TConfig;
>createMachine2 : <TConfig extends Config<TConfig>>(_config: InferNarrowestObject<TConfig>) => TConfig
>_config : InferNarrowestObject<TConfig>

const m3 = createMachine2({
>m3 : { initial: "pending"; states: { pending: { on: { done(): string; }; }; }; }
>createMachine2({    initial: "pending",    states: {        pending: {            on: {                done() { return "noData"; },            },        },    },}) : { initial: "pending"; states: { pending: { on: { done(): string; }; }; }; }
>createMachine2 : <TConfig extends Config<TConfig>>(_config: InferNarrowestObject<TConfig>) => TConfig
>{    initial: "pending",    states: {        pending: {            on: {                done() { return "noData"; },            },        },    },} : { initial: "pending"; states: { pending: { on: { done(): string; }; }; }; }

    initial: "pending",
>initial : "pending"
>"pending" : "pending"

    states: {
>states : { pending: { on: { done(): string; }; }; }
>{        pending: {            on: {                done() { return "noData"; },            },        },    } : { pending: { on: { done(): string; }; }; }

        pending: {
>pending : { on: { done(): string; }; }
>{            on: {                done() { return "noData"; },            },        } : { on: { done(): string; }; }

            on: {
>on : { done(): string; }
>{                done() { return "noData"; },            } : { done(): string; }

                done() { return "noData"; },
>done : () => string
>"noData" : "noData"

            },
        },
    },
});

const m4 = createMachine2({
>m4 : { initial: "pending"; states: { pending: { on: { done: (ev: { type: string; }) => string; }; }; }; }
>createMachine2({    initial: "pending",    states: {        pending: {            on: {                done: ev => ev.type,            },        },    },}) : { initial: "pending"; states: { pending: { on: { done: (ev: { type: string; }) => string; }; }; }; }
