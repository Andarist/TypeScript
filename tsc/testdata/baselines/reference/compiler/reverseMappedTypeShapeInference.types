// A shape-only inference is used when nothing better is available
declare function id<T>(arg: { [K in keyof T]: T[K] }): T;
>id : <T>(arg: { [K in keyof T]: T[K]; }) => T
>arg : { [K in keyof T]: T[K]; }

const s1 = id({ a: { b: x => x } });
>s1 : { a: { b: (x: any) => any; }; }
>id({ a: { b: x => x } }) : { a: { b: (x: any) => any; }; }
>id : <T>(arg: { [K in keyof T]: T[K]; }) => T
>{ a: { b: x => x } } : { a: { b: (x: any) => any; }; }
>a : { b: (x: any) => any; }
>{ b: x => x } : { b: (x: any) => any; }
>b : (x: any) => any
>x => x : (x: any) => any
>x : any
>x : any

const s2 = id({ a: [x => x] });
>s2 : { a: ((x: any) => any)[]; }
>id({ a: [x => x] }) : { a: ((x: any) => any)[]; }
>id : <T>(arg: { [K in keyof T]: T[K]; }) => T
>{ a: [x => x] } : { a: ((x: any) => any)[]; }
>a : ((x: any) => any)[]
>[x => x] : ((x: any) => any)[]
>x => x : (x: any) => any
>x : any
>x : any

const s3 = id({ a: { m() { return 1; } } });
>s3 : { a: { m(): 1; }; }
>id({ a: { m() { return 1; } } }) : { a: { m(): 1; }; }
>id : <T>(arg: { [K in keyof T]: T[K]; }) => T
>{ a: { m() { return 1; } } } : { a: { m(): 1; }; }
>a : { m(): 1; }
>{ m() { return 1; } } : { m(): 1; }
