});

// A shape-only inference yields to a partial inference from another source
declare function on<T>(
>on : <T>(handlers: { [K in keyof T]: (e: T[K]) => void; }, defaults: { [K in keyof T]: T[K]; }) => T

    handlers: { [K in keyof T]: (e: T[K]) => void },
>handlers : { [K in keyof T]: (e: T[K]) => void; }
>e : T[K]

    defaults: { [K in keyof T]: T[K] },
>defaults : { [K in keyof T]: T[K]; }

): T;

const o1 = on({ click: e => e.x }, { click: { x: 1 }, key: k => k });
>o1 : { click: { x: number; }; key: unknown; }
>on({ click: e => e.x }, { click: { x: 1 }, key: k => k }) : { click: { x: number; }; key: unknown; }
>on : <T>(handlers: { [K in keyof T]: (e: T[K]) => void; }, defaults: { [K in keyof T]: T[K]; }) => T
>{ click: e => e.x } : { click: (e: { x: number; }) => number; }
>click : (e: { x: number; }) => number
>e => e.x : (e: { x: number; }) => number
>e : { x: number; }
>e.x : number
>e : { x: number; }
>x : number
>{ click: { x: 1 }, key: k => k } : { click: { x: number; }; key: (k: any) => any; }
>click : { x: number; }
>{ x: 1 } : { x: number; }
>x : number
>1 : 1
>key : (k: any) => any
>k => k : (k: any) => any
>k : any
>k : any

const o2 = on({ click: e => e.x }, { click: { x: 1 } });
>o2 : { click: { x: number; }; }
>on({ click: e => e.x }, { click: { x: 1 } }) : { click: { x: number; }; }
>on : <T>(handlers: { [K in keyof T]: (e: T[K]) => void; }, defaults: { [K in keyof T]: T[K]; }) => T
>{ click: e => e.x } : { click: (e: { x: number; }) => number; }
>click : (e: { x: number; }) => number
>e => e.x : (e: { x: number; }) => number
>e : { x: number; }
>e.x : number
>e : { x: number; }
>x : number
>{ click: { x: 1 } } : { click: { x: number; }; }
