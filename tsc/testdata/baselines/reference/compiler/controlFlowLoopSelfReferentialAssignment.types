// Loop variable of a for statement

type All = A1 | A2 | A3 | A4;
>All : All

class A1 {
>A1 : A1

    nom = "a1" as const;
>nom : "a1"
>"a1" as const : "a1"
>"a1" : "a1"

    next() {
>next : () => A2

        return new A2;
>new A2 : A2
>A2 : typeof A2
    }
}

class A2 {
>A2 : A2

    nom = "a2" as const;
>nom : "a2"
>"a2" as const : "a2"
>"a2" : "a2"

    next() {
>next : () => A3

        return new A3;
>new A3 : A3
>A3 : typeof A3
    }
}

class A3 {
>A3 : A3

    nom = "a3" as const;
>nom : "a3"
>"a3" as const : "a3"
>"a3" : "a3"

    next() {
>next : () => A4

        return new A4;
>new A4 : A4
>A4 : typeof A4
    }
}

class A4 {
>A4 : A4

    nom = "a4" as const;
>nom : "a4"
>"a4" as const : "a4"
>"a4" : "a4"

    next() {
>next : () => null

        return null;
    }
}

function f5(a: A1) {
>f5 : (a: A1) => void
>a : A1

    for (let p: All | null = a; p != null; p = p.next()) {
>p : All | null
>a : A1
>p != null : boolean
>p : All | null
>p = p.next() : A2 | A3 | A4 | null
>p : All | null
>p.next() : A2 | A3 | A4 | null
>p.next : (() => A2) | (() => A3) | (() => A4) | (() => null)
>p : A1 | A2 | A3 | A4
>next : (() => A2) | (() => A3) | (() => A4) | (() => null)

        p; // All
>p : All

        if (p.nom === "a4") {
>p.nom === "a4" : boolean
>p.nom : "a1" | "a2" | "a3" | "a4"
>p : All
>nom : "a1" | "a2" | "a3" | "a4"
>"a4" : "a4"

            p; // A4
>p : A4
        }
    }
}

