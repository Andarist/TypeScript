// Reference in a type predicate call

interface Next<T> { next: T }
>next : T

declare function isNext<T>(x: T): x is T & Next<T>;
>isNext : <T>(x: T) => x is T & Next<T>
>x : T

function f11(start: A) {
>f11 : (start: A) => void
>start : A

    let x: A | B | C | null = start;
>x : A | B | C | null
>start : A

    while (x) {
>x : A | B | C | null

        if (isNext(x)) {
>isNext(x) : boolean
>isNext : <T>(x: T) => x is T & Next<T>
>x : A | B | C

            x;
>x : A & Next<A>
        }
        x = x.next;
>x = x.next : B | C | null
>x : A | B | C | null
>x.next : B | C | null
>x : A | B | C
>next : B | C | null
    }
}

