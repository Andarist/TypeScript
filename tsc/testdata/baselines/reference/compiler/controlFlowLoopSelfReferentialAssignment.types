function f1() {
>f1 : () => void

    let currentParent: GreatGrandParent | GrandParent | Parent | null = child.parent;
>currentParent : GrandParent | GreatGrandParent | Parent | null
>child.parent : Parent | null
>child : Child
>parent : Parent | null

    while (currentParent) {
>currentParent : GrandParent | GreatGrandParent | Parent | null

        currentParent; // GrandParent | GreatGrandParent | Parent
>currentParent : GrandParent | GreatGrandParent | Parent

        currentParent = currentParent.parent;
>currentParent = currentParent.parent : GrandParent | GreatGrandParent | null
>currentParent : GrandParent | GreatGrandParent | Parent | null
>currentParent.parent : GrandParent | GreatGrandParent | null
>currentParent : GrandParent | GreatGrandParent | Parent
>parent : GrandParent | GreatGrandParent | null

        currentParent; // GrandParent | GreatGrandParent | Parent | null
>currentParent : GrandParent | GreatGrandParent | Parent | null
    }
    currentParent; // null
>currentParent : null
}

