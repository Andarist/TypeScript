=== inferenceContextualReturnTypeDiscriminatedUnion.ts ===
// https://github.com/microsoft/TypeScript/issues/64690

type Ok<T> = { ok: true; value: T };
>Ok : Ok<T>
>ok : true
>true : true
>value : T

type Err<E> = { ok: false; value: E };
>Err : Err<E>
>ok : false
>false : false
>value : E

declare function ok<const T>(value: T): Ok<T>;
>ok : <const T>(value: T) => Ok<T>
>value : T

export function f(): Ok<string[]> | Err<string> {
>f : () => Ok<string[]> | Err<string>

    return ok([]);
>ok([]) : Ok<[]>
>ok : <const T>(value: T) => Ok<T>
>[] : []
}

type Success<T> = { kind: "success"; value: T };
>Success : Success<T>
>kind : "success"
>value : T

type Failure<E> = { kind: "failure"; value: E };
>Failure : Failure<E>
>kind : "failure"
>value : E

declare function success<const T>(value: T): Success<T>;
>success : <const T>(value: T) => Success<T>
>value : T

export function withStringTag(): Success<string[]> | Failure<string> {
>withStringTag : () => Success<string[]> | Failure<string>

    return success([]);
>success([]) : Success<[]>
>success : <const T>(value: T) => Success<T>
>[] : []
}

type Accepted<T> = { kind: 1; value: T };
>Accepted : Accepted<T>
>kind : 1
>value : T

type Rejected<E> = { kind: 0; value: E };
>Rejected : Rejected<E>
>kind : 0
>value : E

declare function accepted<const T>(value: T): Accepted<T>;
>accepted : <const T>(value: T) => Accepted<T>
>value : T

export function withNumberTag(): Accepted<string[]> | Rejected<string> {
>withNumberTag : () => Accepted<string[]> | Rejected<string>

    return accepted([]);
>accepted([]) : Accepted<[]>
>accepted : <const T>(value: T) => Accepted<T>
>[] : []
}

declare function unmatched<T>(): { kind: "other"; value: T };
>unmatched : <T>() => { kind: "other"; value: T; }
>kind : "other"
>value : T

// Neither union member matches the fixed tag, so T has no candidates and becomes unknown.
export function withUnmatchedTag(): Success<string[]> | Failure<number[]> {
>withUnmatchedTag : () => Success<string[]> | Failure<number[]>

    return unmatched();
>unmatched() : { kind: "other"; value: unknown; }
>unmatched : <T>() => { kind: "other"; value: T; }
}

