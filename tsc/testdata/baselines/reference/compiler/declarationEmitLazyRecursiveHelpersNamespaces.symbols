>Local : Symbol(Local, Decl(globalA.ts, 9, 28))
>Local : Symbol(Local, Decl(globalA.ts, 9, 28))

        return null as unknown as Local;
>Local : Symbol(Local, Decl(globalA.ts, 9, 28))
    }
}

