    interface Payload { value: string; }
>value : string

    export function strings() {
>strings : () => readonly [Payload, any]

        type Local = readonly [Payload, Local];
>Local : readonly [Payload, any]

        return null as unknown as Local;
>null as unknown as Local : readonly [Payload, any]
>null as unknown : unknown
    }
}

