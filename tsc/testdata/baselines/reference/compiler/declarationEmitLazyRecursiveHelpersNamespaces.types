type show<T> = { [K in keyof T]: T[K] } & unknown;
>show : { [K in keyof T]: T[K]; }

type resolve<T> = show<{ [P in keyof T]: P extends "next" ? resolve<T> : T[P] }>;
>resolve : { [K in keyof { [P in keyof T]: P extends "next" ? { [K in keyof any]: any[K]; } : T[P]; }]: { [P in keyof T]: P extends "next" ? { [K_1 in keyof any]: any[K_1]; } : T[P]; }[K]; }

