>show : { [K in keyof T]: T[K]; }

type resolve<M, K extends keyof M> = show<{
>resolve : { [P in keyof M[K]]: M[K][P] extends "ref" ? any extends infer T_1 ? { [K_1 in keyof T_1]: T_1[K_1]; } : never : M[K][P]; } extends infer T ? { [K_1 in keyof T]: T[K_1]; } : never

    [P in keyof M[K]]: M[K][P] extends "ref" ? resolve<M, K> : M[K][P];
