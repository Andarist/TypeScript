declare const mod: <M>() => { [K in keyof M]: resolve<M, K> };
>mod : <M>() => { [K in keyof M]: resolve<M, K>; }

// Both types have existing paths. Keep both recursive edges without expanding forever.
// Ideal mutual.d.ts:
// export declare const pair: {
//     Left: { leftValue: number; right: typeof pair.Right };
//     Right: { rightValue: string; left: typeof pair.Left };
// };
export const pair = mod<{
>pair : { Left: { leftValue: number; right: { rightValue: string; left: any; }; }; Right: { rightValue: string; left: any; }; }
>mod<{    Left: { leftValue: number; right: "Right" };    Right: { rightValue: string; left: "Left" };}>() : { Left: { leftValue: number; right: { rightValue: string; left: any; }; }; Right: { rightValue: string; left: any; }; }
>mod : <M>() => { [K in keyof M]: resolve<M, K>; }

    Left: { leftValue: number; right: "Right" };
>Left : { leftValue: number; right: "Right"; }
>leftValue : number
>right : "Right"

    Right: { rightValue: string; left: "Left" };
>Right : { rightValue: string; left: "Left"; }
>rightValue : string
>left : "Left"

}>();

// If a helper is needed for a mutually recursive return type, promote only the
// back-edge target. The intermediate Right object can remain inline.
// Ideal declaration (in addition to pair above):
// type left_Result = {
//     leftValue: number;
//     right: { rightValue: string; left: left_Result };
// };
// export declare function left(): left_Result;
export function left() {
>left : () => { leftValue: number; right: { rightValue: string; left: any; }; }

    return mod<{
>mod<{        Left: { leftValue: number; right: "Right" };        Right: { rightValue: string; left: "Left" };    }>().Left : { leftValue: number; right: { rightValue: string; left: any; }; }
>mod<{        Left: { leftValue: number; right: "Right" };        Right: { rightValue: string; left: "Left" };    }>() : { Left: { leftValue: number; right: { rightValue: string; left: any; }; }; Right: { rightValue: string; left: any; }; }
>mod : <M>() => { [K in keyof M]: resolve<M, K>; }

        Left: { leftValue: number; right: "Right" };
>Left : { leftValue: number; right: "Right"; }
>leftValue : number
>right : "Right"

        Right: { rightValue: string; left: "Left" };
>Right : { rightValue: string; left: "Left"; }
>rightValue : string
>left : "Left"

    }>().Left;
>Left : { leftValue: number; right: { rightValue: string; left: any; }; }
}

=== optional.ts ===
type show<T> = { [K in keyof T]: T[K] } & unknown;
>show : { [K in keyof T]: T[K]; }

type resolve<T> = show<{
>resolve : { [K in keyof { [P in keyof T]: NonNullable<T[P]> extends "ref" ? { [K in keyof any]: any[K]; } | Extract<T[P], undefined> : T[P]; }]: { [P in keyof T]: NonNullable<T[P]> extends "ref" ? { [K_1 in keyof any]: any[K_1]; } | Extract<T[P], undefined> : T[P]; }[K]; }

    [P in keyof T]: NonNullable<T[P]> extends "ref"
        ? resolve<T> | Extract<T[P], undefined>
        : T[P];
}>;
