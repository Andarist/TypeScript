//// [tests/cases/compiler/inferenceDiscriminatedUnionSource.ts] ////

=== inferenceDiscriminatedUnionSource.ts ===
// Inference from a union source to an object target skips constituents whose discriminant
// properties can't match the target's, regardless of the order of the union constituents.

type Ok<T> = { ok: true; value: T };
>Ok : Ok<T>
>ok : true
>true : true
>value : T

type Err<E> = { ok: false; value: E };
>Err : Err<E>
>ok : false
>false : false
>value : E

declare function ok<const T>(value: T): Ok<T>;
>ok : <const T>(value: T) => Ok<T>
>value : T

declare function okInline<const T>(value: T): { ok: true; value: T };
>okInline : <const T>(value: T) => { ok: true; value: T; }
>value : T
>ok : true
>true : true
>value : T

// The mismatched constituent comes first in these unions.
type ErrShape = { ok: false; value: string };
>ErrShape : ErrShape
>ok : false
>false : false
>value : string

type OkShape = { ok: true; value: string[] };
>OkShape : OkShape
>ok : true
>true : true
>value : string[]

export function aliasTarget(): ErrShape | OkShape { return ok([]); }
>aliasTarget : () => ErrShape | OkShape
>ok([]) : Ok<[]>
>ok : <const T>(value: T) => Ok<T>
>[] : []

export function inlineTarget(): ErrShape | OkShape { return okInline([]); }
>inlineTarget : () => ErrShape | OkShape
>okInline([]) : { ok: true; value: []; }
>okInline : <const T>(value: T) => { ok: true; value: T; }
>[] : []

export function inlineTargetReversed(): OkShape | ErrShape { return okInline([]); }
>inlineTargetReversed : () => OkShape | ErrShape
>okInline([]) : { ok: true; value: []; }
>okInline : <const T>(value: T) => { ok: true; value: T; }
>[] : []

// Contravariant position: a handler accepting a wider union is assignable, and T is inferred
// from the constituent that matches the tag.
declare function on<T>(handler: (e: { kind: "a"; value: T }) => void): T;
>on : <T>(handler: (e: { kind: "a"; value: T; }) => void) => T
>handler : (e: { kind: "a"; value: T; }) => void
>e : { kind: "a"; value: T; }
>kind : "a"
>value : T

const r1 = on((e: { kind: "a"; value: string } | { kind: "b"; value: number }) => {});
>r1 : string
>on((e: { kind: "a"; value: string } | { kind: "b"; value: number }) => {}) : string
>on : <T>(handler: (e: { kind: "a"; value: T; }) => void) => T
>(e: { kind: "a"; value: string } | { kind: "b"; value: number }) => {} : (e: { kind: "a"; value: string; } | { kind: "b"; value: number; }) => void
>e : { kind: "a"; value: string; } | { kind: "b"; value: number; }
>kind : "a"
>value : string
>kind : "b"
>value : number

const r2 = on((e: { kind: "b"; value: number } | { kind: "a"; value: string }) => {});
>r2 : string
>on((e: { kind: "b"; value: number } | { kind: "a"; value: string }) => {}) : string
>on : <T>(handler: (e: { kind: "a"; value: T; }) => void) => T
>(e: { kind: "b"; value: number } | { kind: "a"; value: string }) => {} : (e: { kind: "b"; value: number; } | { kind: "a"; value: string; }) => void
>e : { kind: "b"; value: number; } | { kind: "a"; value: string; }
>kind : "b"
>value : number
>kind : "a"
>value : string

// Argument position: only the matching constituent contributes to T.
declare function pick<T>(x: { kind: "a"; value: T }): T;
>pick : <T>(x: { kind: "a"; value: T; }) => T
>x : { kind: "a"; value: T; }
>kind : "a"
>value : T

declare const u1: { kind: "b"; value: number } | { kind: "a"; value: string };
>u1 : { kind: "b"; value: number; } | { kind: "a"; value: string; }
>kind : "b"
>value : number
>kind : "a"
>value : string

const r3 = pick(u1);
>r3 : string
>pick(u1) : string
>pick : <T>(x: { kind: "a"; value: T; }) => T
>u1 : { kind: "b"; value: number; } | { kind: "a"; value: string; }

// A constituent with a non-literal tag type may still match.
declare const u2: { kind: string; value: number } | { kind: "a"; value: string };
>u2 : { kind: string; value: number; } | { kind: "a"; value: string; }
>kind : string
>value : number
>kind : "a"
>value : string

const r4 = pick(u2);
>r4 : number
>pick(u2) : number
>pick : <T>(x: { kind: "a"; value: T; }) => T
>u2 : { kind: string; value: number; } | { kind: "a"; value: string; }

// A constituent without the tag is retained.
declare const u3: { value: number } | { kind: "a"; value: string };
>u3 : { value: number; } | { kind: "a"; value: string; }
>value : number
>kind : "a"
>value : string

const r5 = pick(u3);
>r5 : number
>pick(u3) : number
>pick : <T>(x: { kind: "a"; value: T; }) => T
>u3 : { value: number; } | { kind: "a"; value: string; }

// A discriminant that no constituent matches is ignored.
declare function two<T>(x: { kind: "a"; sub: 1; value: T }): T;
>two : <T>(x: { kind: "a"; sub: 1; value: T; }) => T
>x : { kind: "a"; sub: 1; value: T; }
>kind : "a"
>sub : 1
>value : T

declare const u4: { kind: "a"; sub: 2; value: string } | { kind: "b"; sub: 1; value: number };
>u4 : { kind: "a"; sub: 2; value: string; } | { kind: "b"; sub: 1; value: number; }
>kind : "a"
>sub : 2
>value : string
>kind : "b"
>sub : 1
>value : number

const r6 = two(u4);
>r6 : string
>two(u4) : string
>two : <T>(x: { kind: "a"; sub: 1; value: T; }) => T
>u4 : { kind: "a"; sub: 2; value: string; } | { kind: "b"; sub: 1; value: number; }

// Enum and boolean tags.
enum K { A, B }
>K : K
>A : K.A
>B : K.B

declare function enumTag<T>(x: { kind: K.A; value: T }): T;
>enumTag : <T>(x: { kind: K.A; value: T; }) => T
>x : { kind: K.A; value: T; }
>kind : K.A
>K : any
>value : T

declare const u5: { kind: K.B; value: number } | { kind: K.A; value: string };
>u5 : { kind: K.B; value: number; } | { kind: K.A; value: string; }
>kind : K.B
>K : any
>value : number
>kind : K.A
>K : any
>value : string

const r7 = enumTag(u5);
>r7 : string
>enumTag(u5) : string
>enumTag : <T>(x: { kind: K.A; value: T; }) => T
>u5 : { kind: K.B; value: number; } | { kind: K.A; value: string; }

declare function boolTag<T>(x: { ok: boolean; value: T }): T;
>boolTag : <T>(x: { ok: boolean; value: T; }) => T
>x : { ok: boolean; value: T; }
>ok : boolean
>value : T

declare const u6: Err<number> | Ok<string>;
>u6 : Err<number> | Ok<string>

const r8 = boolTag(u6);
>r8 : number
>boolTag(u6) : number
>boolTag : <T>(x: { ok: boolean; value: T; }) => T
>u6 : Err<number> | Ok<string>

// A union source in a nested position.
declare function wrap<const T>(value: T): { result: Ok<T> };
>wrap : <const T>(value: T) => { result: Ok<T>; }
>value : T
>result : Ok<T>

export function nested(): { result: ErrShape | OkShape } { return wrap([]); }
>nested : () => { result: ErrShape | OkShape; }
>result : ErrShape | OkShape
>wrap([]) : { result: Ok<[]>; }
>wrap : <const T>(value: T) => { result: Ok<T>; }
>[] : []

