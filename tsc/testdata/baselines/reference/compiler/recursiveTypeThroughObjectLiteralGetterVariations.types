declare const leaf: Schema<string>;
>leaf : Schema<string>

class Holder {
>Holder : Holder

    static readonly schema = object({
>schema : any
>object({        name: leaf,        get self() {            return Holder.schema;        },    }) : Schema<{ name: string; readonly self: any; }> & { shape: { name: Schema<string>; readonly self: any; }; }
>object : <S extends Shape>(shape: S) => Schema<{ [K in keyof S]: S[K]["out"]; }> & { shape: S; }
>{        name: leaf,        get self() {            return Holder.schema;        },    } : { name: Schema<string>; readonly self: any; }

        name: leaf,
>name : Schema<string>
>leaf : Schema<string>

