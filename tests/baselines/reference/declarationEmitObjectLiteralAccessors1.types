=== declarationEmitObjectLiteralAccessors1.ts ===
// same type accessors
export const obj1 = {
>obj1 : { get x(): string; set x(a: string); }
>     : ^^^^^^^^^^^      ^^^^^^^^ ^^      ^^^^
>{  /** my awesome getter (first in source order) */  get x(): string {    return "";  },  /** my awesome setter (second in source order) */  set x(a: string) {},} : { get x(): string; set x(a: string); }
>                                                                                                                                                                   : ^^^^^^^^^^^      ^^^^^^^^ ^^      ^^^^

  /** my awesome getter (first in source order) */
  get x(): string {
>x : string
>  : ^^^^^^

    return "";
>"" : ""
>   : ^^

  },
  /** my awesome setter (second in source order) */
  set x(a: string) {},
>x : string
>  : ^^^^^^
>a : string
>  : ^^^^^^

};

