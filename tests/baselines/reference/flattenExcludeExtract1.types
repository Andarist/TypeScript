>c : boolean
>  : ^^^^^^^
}

function test1<T>(
>test1 : <T>(arg1: Exclude<Exclude<Exclude<T, A>, B>, C>, arg2: Exclude<T, A | B | C>) => void
>      : ^ ^^    ^^                                     ^^    ^^                     ^^^^^^^^^

  arg1: Exclude<Exclude<Exclude<T, A>, B>, C>,
>arg1 : Exclude<T, A | B | C>
>     : ^^^^^^^^^^^^^^^^^^^^^

  arg2: Exclude<T, A | B | C>,
>arg2 : Exclude<T, A | B | C>
>     : ^^^^^^^^^^^^^^^^^^^^^

) {
  arg1 = arg2;
>arg1 = arg2 : Exclude<T, A | B | C>
>            : ^^^^^^^^^^^^^^^^^^^^^
>arg1 : Exclude<T, A | B | C>
>     : ^^^^^^^^^^^^^^^^^^^^^
>arg2 : Exclude<T, A | B | C>
>     : ^^^^^^^^^^^^^^^^^^^^^

  arg2 = arg1;
>arg2 = arg1 : Exclude<T, A | B | C>
>            : ^^^^^^^^^^^^^^^^^^^^^
>arg2 : Exclude<T, A | B | C>
>     : ^^^^^^^^^^^^^^^^^^^^^
>arg1 : Exclude<T, A | B | C>
>     : ^^^^^^^^^^^^^^^^^^^^^
}

